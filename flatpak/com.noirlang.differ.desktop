[Desktop Entry]
Type=Application
Name=differ
GenericName=Git Change Explorer
Comment=Git change explorer for commit history, diffs, and repository sync
Exec=differ %U
Icon=com.noirlang.differ
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;diff;commit;repository;vcs;
StartupNotify=true
StartupWMClass=differ
MimeType=text/x-git-repo;
